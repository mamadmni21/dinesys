# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Client Configuration (loaded safely in client-side Vite runtime)
# Store your actual keys in .env (ignored by Git)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN="fleet-ai-mp.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="fleet-ai-mp"
VITE_FIREBASE_STORAGE_BUCKET="fleet-ai-mp.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="167536850972"
VITE_FIREBASE_APP_ID="1:167536850972:web:7b1a1bff0e077399dd47d9"
VITE_FIREBASE_DATABASE_ID="ai-studio-39470171-6618-47c1-abc1-fbfa8ed92265"
