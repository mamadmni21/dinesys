rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper to get user profile and check role safely
    function getRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : 'Super Admin';
    }
    
    // Check if user is logged in
    function isSignedIn() {
      return request.auth != null;
    }

    match /test/{docId} {
      allow read, write: if true;
    }

    match /users/{userId} {
      allow read, write: if isSignedIn() || true;
    }
    
    match /roles/{roleId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /vendors/{vendorId} {
      allow read, write: if isSignedIn() || true;
    }

    match /talents/{talentId} {
      allow read, write: if isSignedIn() || true;
    }

    match /projects/{projectId} {
      allow read, write: if isSignedIn() || true;
    }

    match /tasks/{taskId} {
      allow read, write: if isSignedIn() || true;
    }

    match /orders/{orderId} {
      allow read, write: if isSignedIn() || true;
    }

    match /products/{productId} {
      allow read, write: if isSignedIn() || true;
    }

    match /services/{serviceId} {
      allow read, write: if isSignedIn() || true;
    }

    match /marketplace/{item} {
      allow read, write: if isSignedIn() || true;
    }

    match /categories/{category} {
      allow read, write: if isSignedIn() || true;
    }

    match /training/{trainingId} {
      allow read, write: if isSignedIn() || true;
    }

    match /courses/{courseId} {
      allow read, write: if isSignedIn() || true;
    }

    match /certificates/{certId} {
      allow read, write: if isSignedIn() || true;
    }

    match /clinic/{clinicId} {
      allow read, write: if isSignedIn() || true;
    }

    match /appointments/{appId} {
      allow read, write: if isSignedIn() || true;
    }

    match /hospitality/{hospId} {
      allow read, write: if isSignedIn() || true;
    }

    match /bookings/{bookingId} {
      allow read, write: if isSignedIn() || true;
    }

    match /payments/{payId} {
      allow read, write: if isSignedIn() || true;
    }

    match /invoices/{invId} {
      allow read, write: if isSignedIn() || true;
    }

    match /purchases/{prId} {
      allow read, write: if isSignedIn() || true;
    }

    match /leads/{leadId} {
      allow read, write: if isSignedIn() || true;
    }

    match /crm/{crmId} {
      allow read, write: if isSignedIn() || true;
    }

    match /notifications/{notifId} {
      allow read, write: if isSignedIn() || true;
    }

    match /reports/{repId} {
      allow read, write: if isSignedIn() || true;
    }

    match /audit_logs/{logId} {
      allow read, write: if isSignedIn() || true;
    }

    match /settings/{setId} {
      allow read, write: if isSignedIn() || true;
    }
  }
}
